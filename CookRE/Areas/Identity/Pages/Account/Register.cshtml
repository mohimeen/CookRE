@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Register - CookRE</title>


    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
          rel="stylesheet" />


    <!-- Tailwind -->
    <link rel="stylesheet"
          href="~/css/tailwind.css"
          asp-append-version="true" />

</head>


<body class="bg-[#fcf9f8]
             text-[#1b1c1c]
             min-h-screen
             flex flex-col md:flex-row
             font-['Inter']
             antialiased">


    <!-- ========================= -->
    <!-- Editorial Image -->
    <!-- ========================= -->

    <div class="hidden
                md:block
                md:w-1/2
                h-screen
                sticky top-0">

        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDc9rDYh6BjVbAkxdDXzePFFZlL8LcOhTMF9aC1FfQcNDJatz0t2MwrKBPG-4ztfgEB2cvEDGimVuxWhyBl1RQMVaT1ZqRIc1VdeZNgyj4917XxnpYFfZ59HU5QK27ifXRmNMykdABAmL9GP_Ly9v5Ux0PbFfL9BTbmIYqvcG1vzsHb4MDDCRSHbGRoBJTPHelI7ejgOkvrncAydjH9xT5kB6X-01kA1lvytCJKmDPBgSOw54_RZNmf"
             alt="Fresh rustic sourdough bread"
             class="w-full h-full object-cover" />

    </div>



    <!-- ========================= -->
    <!-- Register Side -->
    <!-- ========================= -->

    <div class="min-h-screen
                flex items-center
                justify-center
                p-4 md:p-10
                md:w-1/2
                bg-[#fcf9f8]">


        <div class="max-w-md
                    w-full
                    bg-[#fcf9f8]
                    p-6 md:p-10
                    rounded-xl
                    shadow-lg">


            <!-- ========================= -->
            <!-- Brand -->
            <!-- ========================= -->

            <div class="mb-10
                        flex flex-col
                        items-center
                        gap-2">

                <span class="material-symbols-outlined
                             text-[#6d281a]
                             text-[32px]">

                    restaurant_menu

                </span>


                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="font-['Playfair_Display']
                          text-[32px]
                          font-bold
                          text-[#6d281a]
                          tracking-tight
                          no-underline">

                    CookRE

                </a>

            </div>



            <!-- ========================= -->
            <!-- Header -->
            <!-- ========================= -->

            <div class="mb-10 text-center">

                <h1 class="font-['Playfair_Display']
                           text-[24px]
                           leading-[1.3]
                           font-semibold
                           text-[#1b1c1c]
                           mb-2">

                    Begin Your Journey

                </h1>


                <p class="text-[16px]
                          leading-[1.6]
                          text-[#55433f]">

                    Join our community and curate your modern kitchen.

                </p>

            </div>



            <!-- ========================= -->
            <!-- Register Form -->
            <!-- ========================= -->

            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  class="space-y-6">


                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="text-[#ba1a1a]
                            text-[13px]">
                </div>



                <!-- Email -->
                <div class="flex flex-col gap-1">

                    <label asp-for="Input.Email"
                           class="text-[14px]
                                  font-semibold
                                  tracking-[0.05em]
                                  text-[#55433f]">

                        Email

                    </label>


                    <div class="relative flex items-center">

                        <span class="material-symbols-outlined
                                     absolute
                                     left-4
                                     text-[#87726e]">

                            mail

                        </span>


                        <input asp-for="Input.Email"
                               autocomplete="username"
                               placeholder="name@example.com"
                               class="w-full
                                      bg-[#fcf9f8]
                                      border border-[#dac1bc]
                                      rounded
                                      pl-12 pr-4
                                      py-[14px]
                                      text-[16px]
                                      text-[#1b1c1c]
                                      placeholder:text-[#87726e]
                                      focus:border-[#6d281a]
                                      focus:ring-1
                                      focus:ring-[#6d281a]
                                      outline-none
                                      transition-all" />

                    </div>


                    <span asp-validation-for="Input.Email"
                          class="text-[#ba1a1a]
                                 text-[12px]">
                    </span>

                </div>



                <!-- Password -->
                <div class="flex flex-col gap-1">

                    <label asp-for="Input.Password"
                           class="text-[14px]
                                  font-semibold
                                  tracking-[0.05em]
                                  text-[#55433f]">

                        Password

                    </label>


                    <div class="relative flex items-center">

                        <span class="material-symbols-outlined
                                     absolute
                                     left-4
                                     text-[#87726e]">

                            lock

                        </span>


                        <input asp-for="Input.Password"
                               autocomplete="new-password"
                               placeholder="Create a password"
                               class="w-full
                                      bg-[#fcf9f8]
                                      border border-[#dac1bc]
                                      rounded
                                      pl-12 pr-4
                                      py-[14px]
                                      text-[16px]
                                      text-[#1b1c1c]
                                      placeholder:text-[#87726e]
                                      focus:border-[#6d281a]
                                      focus:ring-1
                                      focus:ring-[#6d281a]
                                      outline-none
                                      transition-all" />

                    </div>


                    <span asp-validation-for="Input.Password"
                          class="text-[#ba1a1a]
                                 text-[12px]">
                    </span>

                </div>



                <!-- Confirm Password -->
                <div class="flex flex-col gap-1">

                    <label asp-for="Input.ConfirmPassword"
                           class="text-[14px]
                                  font-semibold
                                  tracking-[0.05em]
                                  text-[#55433f]">

                        Confirm Password

                    </label>


                    <div class="relative flex items-center">

                        <span class="material-symbols-outlined
                                     absolute
                                     left-4
                                     text-[#87726e]">

                            lock_reset

                        </span>


                        <input asp-for="Input.ConfirmPassword"
                               autocomplete="new-password"
                               placeholder="Repeat password"
                               class="w-full
                                      bg-[#fcf9f8]
                                      border border-[#dac1bc]
                                      rounded
                                      pl-12 pr-4
                                      py-[14px]
                                      text-[16px]
                                      text-[#1b1c1c]
                                      placeholder:text-[#87726e]
                                      focus:border-[#6d281a]
                                      focus:ring-1
                                      focus:ring-[#6d281a]
                                      outline-none
                                      transition-all" />

                    </div>


                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-[#ba1a1a]
                                 text-[12px]">
                    </span>

                </div>



                <!-- Register -->
                <div class="pt-2">

                    <button id="registerSubmit"
                            type="submit"
                            class="w-full
                                   flex items-center
                                   justify-center
                                   gap-2
                                   bg-[#6d281a]
                                   text-white
                                   text-[14px]
                                   font-semibold
                                   tracking-[0.05em]
                                   rounded-full
                                   py-[14px]
                                   hover:opacity-90
                                   hover:shadow-lg
                                   transition-all
                                   duration-300">

                        <span>
                            Register
                        </span>

                        <span class="material-symbols-outlined text-[20px]">
                            arrow_forward
                        </span>

                    </button>

                </div>

            </form>



            <!-- ========================= -->
            <!-- Login -->
            <!-- ========================= -->

            <div class="mt-10
                        text-center
                        pt-6">


                <p class="text-[16px]
                          text-[#55433f]">

                    Already have an account?

                    <a asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="text-[14px]
                              font-semibold
                              tracking-[0.05em]
                              text-[#6d281a]
                              hover:underline
                              underline-offset-4">

                        Log in

                    </a>

                </p>


                <p class="text-[12px]
                          text-[#87726e]
                          mt-2
                          max-w-xs
                          mx-auto">

                    By registering, you agree to our Terms of Service
                    and Privacy Policy.

                </p>

            </div>


        </div>

    </div>



    <!-- ========================= -->
    <!-- Validation Scripts -->
    <!-- ========================= -->

    <partial name="_ValidationScriptsPartial" />


</body>

</html>