@model CookRE.Models.Recipe

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-8">

            <div class="mb-5">
                <h1 class="fw-bold">Create a New Recipe</h1>
                <p class="text-muted">
                    Share your recipe with the CookRE community.
                </p>
            </div>


            <form asp-action="Create" method="post">

                <!-- Recipe Name -->
                <div class="mb-4">

                    <label asp-for="Name" class="form-label fw-semibold">
                        Recipe Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Homemade Pizza" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- Overview -->
                <div class="mb-4">

                    <label asp-for="Overview" class="form-label fw-semibold">
                        Overview
                    </label>

                    <textarea asp-for="Overview"
                              class="form-control"
                              rows="4"
                              placeholder="Tell us about your recipe...">
                    </textarea>

                    <span asp-validation-for="Overview"
                          class="text-danger">
                    </span>

                </div>


                <!-- Ingredients -->
                <div class="mb-4">

                    <label asp-for="Ingredients"
                           class="form-label fw-semibold">
                        Ingredients
                    </label>

                    <textarea asp-for="Ingredients"
                              class="form-control"
                              rows="6"
                              placeholder="e.g.&#10;2 cups flour&#10;1 tsp salt&#10;1 cup water">
                    </textarea>

                    <span asp-validation-for="Ingredients"
                          class="text-danger">
                    </span>

                </div>


                <!-- Steps -->
                <div class="mb-4">

                    <label asp-for="Steps"
                           class="form-label fw-semibold">
                        Cooking Steps
                    </label>

                    <textarea asp-for="Steps"
                              class="form-control"
                              rows="7"
                              placeholder="Describe the cooking steps...">
                    </textarea>

                    <span asp-validation-for="Steps"
                          class="text-danger">
                    </span>

                </div>


                <!-- Image -->
                <div class="mb-5">

                    <label asp-for="ImageUrl"
                           class="form-label fw-semibold">
                        Recipe Image
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="Paste image URL..." />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Add a direct URL to an image for your recipe.
                    </div>

                </div>


                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Recipe
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>