@using System.Security.Claims
@model CookRE.Models.Recipe

<div class="container py-5">

    <!-- Recipe Header -->
    <div class="row g-5 align-items-start">

        <!-- Image -->
        <div class="col-12 col-lg-6">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="img-fluid rounded-4 shadow-sm w-100"
                     style="height: 450px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-light rounded-4 d-flex align-items-center justify-content-center"
                     style="height: 450px;">
                    <span class="text-muted">No image available</span>
                </div>
            }

        </div>

        <!-- Recipe Info -->
        <div class="col-12 col-lg-6">

            <span class="text-uppercase text-muted small">
                Recipe
            </span>

            <h1 class="display-4 fw-bold mt-2">
                @Model.Name
            </h1>

            <p class="lead text-muted mt-4">
                @Model.Overview
            </p>

            @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId)
            {
                <div class="d-flex gap-2 mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Edit Recipe
                    </a>

                    <button type="button"
                            class="btn btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal-@Model.Id">
                        Delete
                    </button>

                </div>
            }
            <div class="modal fade"
                 id="deleteModal-@Model.Id"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">
                                Delete Recipe
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="modal-body">

                            <p>
                                Are you sure you want to delete
                                <strong>@Model.Name</strong>?
                            </p>

                            <p class="text-muted mb-0">
                                This action cannot be undone.
                            </p>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <form asp-action="Delete"
                                  asp-route-id="@Model.Id"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-danger">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Ingredients -->
    <div class="row mt-5">

        <div class="col-12 col-lg-5">

            <h2 class="fw-bold mb-4">
                Ingredients
            </h2>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <p class="mb-0">
                        @Model.Ingredients
                    </p>

                </div>
            </div>

        </div>


        <!-- Steps -->
        <div class="col-12 col-lg-7 mt-5 mt-lg-0">

            <h2 class="fw-bold mb-4">
                Instructions
            </h2>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <p class="mb-0">
                        @Model.Steps
                    </p>

                </div>
            </div>

        </div>

    </div>


    <!-- Back -->
    <div class="mt-5">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Recipes
        </a>

    </div>

</div>