@model CookRE.Models.Recipe

@{
    ViewData["Title"] = "Edit Recipe";
}


<section class="py-10 md:py-16">

    <div class="w-full
                max-w-4xl
                mx-auto
                bg-[#fcf9f8]
                border border-[#dac1bc]
                rounded-lg
                p-6 md:p-10
                shadow-[0_8px_24px_rgba(45,45,45,0.05)]">


        <!-- Header -->
        <div class="mb-10 text-center">

            <p class="font-['Inter']
                      text-[12px]
                      font-semibold
                      tracking-[0.12em]
                      uppercase
                      text-[#87726e]
                      mb-3">

                Editing Recipe

            </p>

            <h1 class="font-['Playfair_Display']
                       text-[36px] md:text-[48px]
                       leading-[1.1]
                       font-bold
                       text-[#6d281a]
                       mb-2">

                Edit Recipe

            </h1>

            <p class="font-['Inter']
                      text-[18px]
                      leading-[1.6]
                      text-[#55433f]">

                Refine your recipe and keep your culinary creation up to date.

            </p>

        </div>



        <!-- Form -->
        <form asp-action="Edit"
              method="post"
              class="space-y-6">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />


            <!-- Recipe Name -->
            <div>

                <label asp-for="Name"
                       class="block
                              font-['Inter']
                              text-[14px]
                              font-semibold
                              tracking-[0.05em]
                              text-[#1b1c1c]
                              mb-1">

                    Recipe Name

                    <span class="text-[#ba1a1a]">
                        *
                    </span>

                </label>

                <input asp-for="Name"
                       class="w-full
                              bg-[#fcf9f8]
                              border border-[#dac1bc]
                              rounded
                              p-4
                              font-['Inter']
                              text-[16px]
                              text-[#1b1c1c]
                              outline-none
                              focus:border-[#6d281a]
                              focus:ring-1
                              focus:ring-[#6d281a]
                              transition-all" />

                <span asp-validation-for="Name"
                      class="block
                             mt-2
                             font-['Inter']
                             text-[12px]
                             text-[#ba1a1a]">
                </span>

            </div>



            <!-- Overview -->
            <div>

                <label asp-for="Overview"
                       class="block
                              font-['Inter']
                              text-[14px]
                              font-semibold
                              tracking-[0.05em]
                              text-[#1b1c1c]
                              mb-1">

                    Overview

                </label>

                <textarea asp-for="Overview"
                          rows="3"
                          class="w-full
                                 bg-[#fcf9f8]
                                 border border-[#dac1bc]
                                 rounded
                                 p-4
                                 font-['Inter']
                                 text-[16px]
                                 text-[#1b1c1c]
                                 outline-none
                                 resize-none
                                 focus:border-[#6d281a]
                                 focus:ring-1
                                 focus:ring-[#6d281a]
                                 transition-all"></textarea>

                <p class="mt-1
                          font-['Inter']
                          text-[12px]
                          text-[#55433f]">

                    Give readers a concise introduction to your dish.

                </p>

                <span asp-validation-for="Overview"
                      class="block
                             mt-1
                             font-['Inter']
                             text-[12px]
                             text-[#ba1a1a]">
                </span>

            </div>



            <!-- Ingredients + Steps -->
            <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        gap-6">


                <!-- Ingredients -->
                <div>

                    <label asp-for="Ingredients"
                           class="block
                                  font-['Inter']
                                  text-[14px]
                                  font-semibold
                                  tracking-[0.05em]
                                  text-[#1b1c1c]
                                  mb-1">

                        Ingredients

                    </label>

                    <textarea asp-for="Ingredients"
                              rows="8"
                              class="w-full
                                     bg-[#fcf9f8]
                                     border border-[#dac1bc]
                                     rounded
                                     p-4
                                     font-['Inter']
                                     text-[16px]
                                     leading-relaxed
                                     text-[#1b1c1c]
                                     outline-none
                                     resize-none
                                     focus:border-[#6d281a]
                                     focus:ring-1
                                     focus:ring-[#6d281a]
                                     transition-all"></textarea>

                    <p class="mt-1
                              font-['Inter']
                              text-[12px]
                              text-[#55433f]">

                        List one ingredient per line.

                    </p>

                    <span asp-validation-for="Ingredients"
                          class="block
                                 mt-1
                                 font-['Inter']
                                 text-[12px]
                                 text-[#ba1a1a]">
                    </span>

                </div>



                <!-- Steps -->
                <div>

                    <label asp-for="Steps"
                           class="block
                                  font-['Inter']
                                  text-[14px]
                                  font-semibold
                                  tracking-[0.05em]
                                  text-[#1b1c1c]
                                  mb-1">

                        Cooking Steps

                    </label>

                    <textarea asp-for="Steps"
                              rows="8"
                              class="w-full
                                     bg-[#fcf9f8]
                                     border border-[#dac1bc]
                                     rounded
                                     p-4
                                     font-['Inter']
                                     text-[16px]
                                     leading-relaxed
                                     text-[#1b1c1c]
                                     outline-none
                                     resize-none
                                     focus:border-[#6d281a]
                                     focus:ring-1
                                     focus:ring-[#6d281a]
                                     transition-all"></textarea>

                    <p class="mt-1
                              font-['Inter']
                              text-[12px]
                              text-[#55433f]">

                        Keep each instruction clear and easy to follow.

                    </p>

                    <span asp-validation-for="Steps"
                          class="block
                                 mt-1
                                 font-['Inter']
                                 text-[12px]
                                 text-[#ba1a1a]">
                    </span>

                </div>

            </div>



            <!-- Image URL -->
            <div>

                <label asp-for="ImageUrl"
                       class="block
                              font-['Inter']
                              text-[14px]
                              font-semibold
                              tracking-[0.05em]
                              text-[#1b1c1c]
                              mb-1">

                    Featured Image URL

                </label>

                <div class="flex
                            flex-col
                            sm:flex-row
                            gap-4
                            items-stretch sm:items-center">

                    <input asp-for="ImageUrl"
                           id="recipe-image"
                           class="flex-grow
                                  w-full
                                  bg-[#fcf9f8]
                                  border border-[#dac1bc]
                                  rounded
                                  p-4
                                  font-['Inter']
                                  text-[16px]
                                  text-[#1b1c1c]
                                  outline-none
                                  focus:border-[#6d281a]
                                  focus:ring-1
                                  focus:ring-[#6d281a]
                                  transition-all" />


                   
                    <!-- Image Preview -->
                    <div class="w-24 h-24
            flex-shrink-0
            bg-[#f0eded]
            border border-[#dac1bc]
            rounded
            overflow-hidden
            relative">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img id="image-preview"
                                 src="@Model.ImageUrl"
                                 alt="Recipe preview"
                                 class="absolute inset-0 w-full h-full object-cover" />

                            <span id="image-placeholder"
                                  class="material-symbols-outlined
                         absolute inset-0
                         items-center justify-center
                         text-[28px] text-[#87726e]"
                                  style="display: none;">
                                image
                            </span>
                        }
                        else
                        {
                            <img id="image-preview"
                                 src=""
                                 alt="Recipe preview"
                                 class="absolute inset-0 w-full h-full object-cover"
                                 style="display: none;" />

                            <span id="image-placeholder"
                                  class="material-symbols-outlined
                         absolute inset-0
                         flex items-center justify-center
                         text-[28px] text-[#87726e]">
                                image
                            </span>
                        }

                    </div>

                </div>

                <p class="mt-1
                          font-['Inter']
                          text-[12px]
                          text-[#55433f]">

                    Update the image link if you want to change the featured photo.

                </p>

                <span asp-validation-for="ImageUrl"
                      class="block
                             mt-1
                             font-['Inter']
                             text-[12px]
                             text-[#ba1a1a]">
                </span>

            </div>



            <!-- Actions -->
            <div class="pt-10
                        flex
                        flex-col-reverse sm:flex-row
                        justify-end
                        gap-4
                        border-t border-[#dac1bc]
                        mt-10">

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="px-10 py-4
                          border border-[#6d281a]
                          text-[#6d281a]
                          font-['Inter']
                          text-[14px]
                          font-semibold
                          tracking-[0.05em]
                          rounded
                          text-center
                          hover:bg-[#f6f3f2]
                          transition-colors
                          no-underline">

                    Cancel

                </a>

                <button type="submit"
                        class="px-10 py-4
                               bg-[#8b3e2f]
                               text-white
                               font-['Inter']
                               text-[14px]
                               font-semibold
                               tracking-[0.05em]
                               rounded
                               hover:bg-[#6d281a]
                               transition-colors">

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</section>


<script>

    const imageInput = document.getElementById("recipe-image");
    const imagePreview = document.getElementById("image-preview");
    const imagePlaceholder = document.getElementById("image-placeholder");


    function updateImagePreview() {

        const url = imageInput.value.trim();

        if (!url) {

            imagePreview.classList.add("hidden");
            imagePlaceholder.classList.remove("hidden");

            return;
        }

        imagePreview.src = url;

        imagePreview.onload = function () {

            imagePreview.classList.remove("hidden");
            imagePlaceholder.classList.add("hidden");

        };

        imagePreview.onerror = function () {

            imagePreview.classList.add("hidden");
            imagePlaceholder.classList.remove("hidden");

        };

    }


    imageInput.addEventListener("input", updateImagePreview);

</script>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}