@model CookRE.Models.Recipe

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-8">

            <div class="mb-5">
                <h1 class="fw-bold">Edit Recipe</h1>
                <p class="text-muted">
                    Update your recipe details.
                </p>
            </div>

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold">
                        Recipe Name
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Overview" class="form-label fw-semibold">
                        Overview
                    </label>

                    <textarea asp-for="Overview"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Overview"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Ingredients"
                           class="form-label fw-semibold">
                        Ingredients
                    </label>

                    <textarea asp-for="Ingredients"
                              class="form-control"
                              rows="6">
                    </textarea>

                    <span asp-validation-for="Ingredients"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Steps"
                           class="form-label fw-semibold">
                        Cooking Steps
                    </label>

                    <textarea asp-for="Steps"
                              class="form-control"
                              rows="7">
                    </textarea>

                    <span asp-validation-for="Steps"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-5">
                    <label asp-for="ImageUrl"
                           class="form-label fw-semibold">
                        Recipe Image
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="Paste image URL..." />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>