@using System.Security.Claims
@model List<CookRE.Models.Recipe>

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5">

        <div>
            <h1 class="fw-bold mb-2">Explore Recipes</h1>

            <p class="text-muted mb-0">
                Discover recipes shared by the CookRE community.
            </p>
        </div>

       

    </div>


    <!-- Search -->
    <form asp-action="Index"
          method="get"
          class="mb-5">

        <div class="input-group input-group-lg">

            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Search recipes..." />

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

        </div>

    </form>


    <!-- Empty Search Result -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <h3 class="fw-semibold">
                No recipes found.
            </h3>

            <p class="text-muted">
                Try searching for something else.
            </p>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                View All Recipes
            </a>

        </div>
    }
    else
    {
        <!-- Recipe Grid -->
        <div class="row g-4">

            @foreach (var recipe in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm overflow-hidden">

                        @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                        {
                            <img src="@recipe.ImageUrl"
                                 class="card-img-top"
                                 alt="@recipe.Name"
                                 style="height: 230px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center text-muted"
                                 style="height: 230px;">
                                No Image
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-4">

                            <h3 class="card-title h4 fw-bold">
                                @recipe.Name
                            </h3>

                            <p class="card-text text-muted">
                                @recipe.Overview
                            </p>

                            <div class="mt-auto pt-3">

                                <a asp-action="Details"
                                   asp-route-id="@recipe.Id"
                                   class="btn btn-primary">
                                    View Recipe
                                </a>

                                @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == recipe.UserId)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@recipe.Id"
                                       class="btn btn-outline-secondary">
                                        Edit
                                    </a>

                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@recipe.Id">
                                        Delete
                                    </button>
                                }

                            </div>

                        </div>

                    </div>


                    @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == recipe.UserId)
                    {
                        <!-- Delete Modal -->
                        <div class="modal fade"
                             id="deleteModal-@recipe.Id"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content">

                                    <div class="modal-header">

                                        <h5 class="modal-title">
                                            Delete Recipe
                                        </h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body">

                                        <p>
                                            Are you sure you want to delete
                                            <strong>@recipe.Name</strong>?
                                        </p>

                                        <p class="text-muted mb-0">
                                            This action cannot be undone.
                                        </p>

                                    </div>

                                    <div class="modal-footer">

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <form asp-action="Delete"
                                              asp-route-id="@recipe.Id"
                                              method="post">

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    }

</div>