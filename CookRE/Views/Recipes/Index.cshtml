@using System.Security.Claims
@model List<CookRE.Models.Recipe>

@{
    ViewData["Title"] = "Explore Recipes";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<section class="py-10 md:py-16">

    <!-- ========================= -->
    <!-- Header + Search -->
    <!-- ========================= -->

    <header class="mb-16
                   flex flex-col
                   md:flex-row
                   md:items-end
                   justify-between
                   gap-10">

        <div>

            <h1 class="font-['Playfair_Display']
                       text-[36px] md:text-[48px]
                       leading-[1.1]
                       font-bold
                       text-[#6d281a]
                       mb-2">

                Explore Recipes

            </h1>

            <p class="font-['Inter']
                      text-[18px]
                      leading-[1.6]
                      text-[#55433f]
                      max-w-2xl">

                Discover culinary inspiration shared by the CookRE community.

            </p>

        </div>


        <!-- Search -->
        <form asp-action="Index"
              method="get"
              class="flex-grow max-w-md w-full relative">

            <span class="material-symbols-outlined
                         absolute left-4 top-1/2
                         -translate-y-1/2
                         text-[#87726e]">

                search

            </span>

            <input type="text"
                   name="search"
                   placeholder="Search recipes or ingredients..."
                   class="w-full
                          bg-[#fcf9f8]
                          border-0
                          border-b
                          border-[#dac1bc]
                          focus:border-[#6d281a]
                          py-4
                          pl-12
                          pr-4
                          font-['Inter']
                          text-[16px]
                          text-[#1b1c1c]
                          outline-none
                          transition-colors
                          placeholder:text-[#87726e]" />

        </form>

    </header>



    <!-- ========================= -->
    <!-- Empty State -->
    <!-- ========================= -->
    @if (!Model.Any())
    {
        <div class="py-24 text-center
                        border-y border-[#dac1bc]">

            <span class="material-symbols-outlined
                             text-[56px]
                             text-[#87726e]">

                restaurant_menu

            </span>

            <h2 class="font-['Playfair_Display']
                           text-[28px]
                           font-semibold
                           text-[#1b1c1c]
                           mt-5">

                No recipes found

            </h2>

            <p class="font-['Inter']
                          text-[#55433f]
                          mt-2">

                Try searching for something else.

            </p>

            <a asp-action="Index"
               class="inline-block
                          mt-6
                          border border-[#6d281a]
                          text-[#6d281a]
                          px-6 py-3
                          font-semibold
                          hover:bg-[#f6f3f2]
                          transition-colors
                          no-underline">

                View All Recipes

            </a>

        </div>
    }
    else
    {

        <!-- ========================= -->
        <!-- Recipe Grid -->
        <!-- ========================= -->

        <section class="grid
                            grid-cols-1
                            md:grid-cols-2
                            lg:grid-cols-3
                            gap-6 lg:gap-10">

            @foreach (var recipe in Model)
            {
                <article class="group
                                        relative
                                        flex flex-col
                                        bg-[#fcf9f8]
                                        border border-[#dac1bc]
                                        hover:shadow-[0_8px_24px_rgba(45,45,45,0.05)]
                                        transition-shadow
                                        duration-300">

                    <!-- Image -->
                    <div class="aspect-[3/4]
                                        overflow-hidden
                                        relative
                                        bg-[#f6f3f2]">

                        @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                        {
                            <img src="@recipe.ImageUrl"
                                 alt="@recipe.Name"
                                 class="w-full h-full
                                                    object-cover
                                                    group-hover:scale-105
                                                    transition-transform
                                                    duration-700
                                                    ease-in-out" />
                        }
                        else
                        {
                            <div class="w-full h-full
                                                    flex items-center
                                                    justify-center
                                                    text-[#87726e]">

                                <span class="material-symbols-outlined text-[52px]">
                                    image
                                </span>

                            </div>
                        }


                        <!-- Owner Actions -->
                        @if (currentUserId == recipe.UserId)
                        {
                            <div class="absolute
                                                    top-3 right-3
                                                    flex gap-1
                                                    opacity-0
                                                    group-hover:opacity-100
                                                    transition-opacity
                                                    bg-[#fcf9f8]/90
                                                    backdrop-blur-sm
                                                    p-1
                                                    rounded">

                                <!-- Edit -->
                                <a asp-action="Edit"
                                   asp-route-id="@recipe.Id"
                                   title="Edit"
                                   class="p-2
                                                      text-[#55433f]
                                                      hover:text-[#6d281a]
                                                      transition-colors
                                                      no-underline">

                                    <span class="material-symbols-outlined text-[18px]">
                                        edit
                                    </span>

                                </a>


                                <!-- Delete -->
                                <button type="button"
                                        title="Delete"
                                        onclick="document.getElementById('deleteModal-@recipe.Id').showModal()"
                                        class="p-2
                                                           text-[#55433f]
                                                           hover:text-[#ba1a1a]
                                                           transition-colors">

                                    <span class="material-symbols-outlined text-[18px]">
                                        delete
                                    </span>

                                </button>

                            </div>
                        }

                    </div>



                    <!-- Content -->
                    <div class="p-6
                                        flex flex-col
                                        flex-grow">

                        <h2 class="font-['Playfair_Display']
                                           text-[24px]
                                           leading-[1.3]
                                           font-semibold
                                           text-[#1b1c1c]
                                           mb-1">

                            @recipe.Name

                        </h2>


                        <p class="font-['Inter']
                                          text-[16px]
                                          leading-[1.6]
                                          text-[#55433f]
                                          mb-4
                                          flex-grow">

                            @recipe.Overview

                        </p>


                        <a asp-action="Details"
                           asp-route-id="@recipe.Id"
                           class="font-['Inter']
                                          text-[14px]
                                          font-semibold
                                          tracking-[0.05em]
                                          text-[#6d281a]
                                          hover:text-[#8b3e2f]
                                          transition-colors
                                          flex items-center
                                          gap-1
                                          mt-auto
                                          no-underline">

                            View Recipe

                            <span class="material-symbols-outlined text-[16px]">
                                arrow_forward
                            </span>

                        </a>

                    </div>

                </article>



                @if (currentUserId == recipe.UserId)
                {
                    <!-- ========================= -->
                    <!-- Delete Modal -->
                    <!-- ========================= -->

                    <dialog id="deleteModal-@recipe.Id"
                            class="m-auto
                                               w-[calc(100%-32px)]
                                               max-w-md
                                               bg-[#fcf9f8]
                                               p-0
                                               border border-[#dac1bc]
                                               shadow-2xl
                                               backdrop:bg-black/60">

                        <div class="p-7">

                            <div class="flex items-start
                                                    justify-between
                                                    gap-4">

                                <div>

                                    <p class="font-['Inter']
                                                          text-[12px]
                                                          font-semibold
                                                          tracking-[0.08em]
                                                          uppercase
                                                          text-[#ba1a1a]
                                                          mb-2">

                                        Delete Recipe

                                    </p>

                                    <h2 class="font-['Playfair_Display']
                                                           text-[26px]
                                                           font-semibold
                                                           text-[#1b1c1c]">

                                        Delete @recipe.Name?

                                    </h2>

                                </div>


                                <button type="button"
                                        onclick="document.getElementById('deleteModal-@recipe.Id').close()"
                                        class="text-[#87726e]
                                                           hover:text-[#1b1c1c]">

                                    <span class="material-symbols-outlined">
                                        close
                                    </span>

                                </button>

                            </div>


                            <p class="font-['Inter']
                                                  text-[15px]
                                                  leading-[1.6]
                                                  text-[#55433f]
                                                  mt-4">

                                This recipe will be permanently deleted.
                                This action cannot be undone.

                            </p>


                            <div class="flex
                                                    justify-end
                                                    gap-3
                                                    mt-7">

                                <button type="button"
                                        onclick="document.getElementById('deleteModal-@recipe.Id').close()"
                                        class="border border-[#87726e]
                                                           text-[#55433f]
                                                           px-5 py-2.5
                                                           font-semibold
                                                           hover:bg-[#f6f3f2]
                                                           transition-colors">

                                    Cancel

                                </button>


                                <form asp-action="Delete"
                                      asp-route-id="@recipe.Id"
                                      method="post">

                                    <button type="submit"
                                            class="bg-[#ba1a1a]
                                                               text-white
                                                               px-5 py-2.5
                                                               font-semibold
                                                               hover:opacity-90
                                                               transition-opacity">

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </dialog>
                }
            }

        </section>
    }

</section>