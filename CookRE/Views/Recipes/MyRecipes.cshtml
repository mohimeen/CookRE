@model List<CookRE.Models.Recipe>

@{
    ViewData["Title"] = "My Recipes";
}


<section class="py-10 md:py-16">


    <!-- ========================= -->
    <!-- Header -->
    <!-- ========================= -->

    <div class="text-center
                max-w-2xl
                mx-auto
                mb-12 md:mb-16">

        <h1 class="font-['Playfair_Display']
                   text-[36px] md:text-[48px]
                   leading-[1.1]
                   font-bold
                   text-[#6d281a]
                   mb-2">

            My Recipe Collection

        </h1>

        <p class="font-['Inter']
                  text-[18px]
                  leading-[1.6]
                  text-[#55433f]">

            Your curated list of personal creations.

        </p>

    </div>



    @if (Model.Any())
    {
        <!-- ========================= -->
        <!-- Recipes Grid -->
        <!-- ========================= -->

        <div class="grid
                        grid-cols-1
                        md:grid-cols-2
                        lg:grid-cols-3
                        gap-6">


            @foreach (var recipe in Model)
            {
                <article class="group
                                        relative
                                        bg-[#fcf9f8]
                                        border border-[#dac1bc]
                                        rounded
                                        overflow-hidden
                                        flex flex-col
                                        h-full
                                        shadow-[0_8px_24px_rgba(45,45,45,0.05)]
                                        transition-all
                                        duration-300
                                        hover:-translate-y-1
                                        hover:shadow-[0_12px_30px_rgba(45,45,45,0.10)]">


                    <!-- ========================= -->
                    <!-- Image -->
                    <!-- ========================= -->

                    <div class="relative
                                        aspect-[3/4]
                                        w-full
                                        overflow-hidden
                                        bg-[#f0eded]">


                        @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                        {
                            <img src="@recipe.ImageUrl"
                                 alt="@recipe.Name"
                                 class="w-full
                                                    h-full
                                                    object-cover
                                                    transition-transform
                                                    duration-500
                                                    group-hover:scale-105" />
                        }
                        else
                        {
                            <div class="w-full
                                                    h-full
                                                    flex
                                                    flex-col
                                                    items-center
                                                    justify-center
                                                    gap-2
                                                    text-[#87726e]">

                                <span class="material-symbols-outlined text-[40px]">
                                    restaurant
                                </span>

                                <span class="font-['Inter'] text-[13px]">
                                    No Image
                                </span>

                            </div>
                        }



                        <!-- ========================= -->
                        <!-- Hover Overlay -->
                        <!-- ========================= -->

                        <div class="absolute
                                            inset-0
                                            bg-[#303030]/40
                                            opacity-0
                                            group-hover:opacity-100
                                            transition-opacity
                                            duration-300
                                            flex
                                            items-center
                                            justify-center
                                            gap-4">


                            <!-- View -->
                            <a asp-action="Details"
                               asp-route-id="@recipe.Id"
                               title="View Recipe"
                               class="w-11 h-11
                                              bg-[#fcf9f8]
                                              text-[#55433f]
                                              rounded-full
                                              flex
                                              items-center
                                              justify-center
                                              hover:bg-white
                                              hover:scale-110
                                              transition-all
                                              no-underline">

                                <span class="material-symbols-outlined">
                                    visibility
                                </span>

                            </a>


                            <!-- Edit -->
                            <a asp-action="Edit"
                               asp-route-id="@recipe.Id"
                               title="Edit Recipe"
                               class="w-11 h-11
                                              bg-[#fcf9f8]
                                              text-[#6d281a]
                                              rounded-full
                                              flex
                                              items-center
                                              justify-center
                                              hover:bg-white
                                              hover:scale-110
                                              transition-all
                                              no-underline">

                                <span class="material-symbols-outlined">
                                    edit
                                </span>

                            </a>


                            <!-- Delete -->
                            <button type="button"
                                    title="Delete Recipe"
                                    onclick="openDeleteModal(@recipe.Id, '@Html.Raw(recipe.Name.Replace("'", "\\'"))')"
                                    class="w-11 h-11
                                                   bg-[#fcf9f8]
                                                   text-[#ba1a1a]
                                                   rounded-full
                                                   flex
                                                   items-center
                                                   justify-center
                                                   hover:bg-[#ffdad6]
                                                   hover:scale-110
                                                   transition-all
                                                   cursor-pointer">

                                <span class="material-symbols-outlined">
                                    delete
                                </span>

                            </button>

                        </div>

                    </div>



                    <!-- ========================= -->
                    <!-- Card Content -->
                    <!-- ========================= -->

                    <div class="p-5
                                        flex
                                        flex-col
                                        flex-grow">


                        <h2 class="font-['Playfair_Display']
                                           text-[24px]
                                           leading-[1.3]
                                           font-semibold
                                           text-[#1b1c1c]
                                           mb-2">

                            @recipe.Name

                        </h2>


                        @if (!string.IsNullOrWhiteSpace(recipe.Overview))
                        {
                            <p class="font-['Inter']
                                                  text-[15px]
                                                  leading-[1.6]
                                                  text-[#55433f]
                                                  line-clamp-3
                                                  mb-5">

                                @recipe.Overview

                            </p>
                        }


                        <div class="mt-auto
                                            pt-4
                                            border-t
                                            border-[#dac1bc]">

                            <a asp-action="Details"
                               asp-route-id="@recipe.Id"
                               class="inline-flex
                                              items-center
                                              gap-1
                                              font-['Inter']
                                              text-[14px]
                                              font-semibold
                                              tracking-[0.05em]
                                              text-[#6d281a]
                                              hover:gap-2
                                              transition-all
                                              no-underline">

                                View Recipe

                                <span class="material-symbols-outlined text-[18px]">
                                    arrow_forward
                                </span>

                            </a>

                        </div>

                    </div>

                </article>
            }

        </div>
    }
    else
    {
        <!-- ========================= -->
        <!-- Empty State -->
        <!-- ========================= -->

        <div class="py-16
                        border-t border-[#dac1bc]
                        flex
                        flex-col
                        items-center
                        justify-center
                        text-center">


            <div class="w-24 h-24
                            bg-[#f0eded]
                            rounded-full
                            flex
                            items-center
                            justify-center
                            mb-6
                            border border-[#dac1bc]">

                <span class="material-symbols-outlined
                                 text-[40px]
                                 text-[#87726e]">

                    menu_book

                </span>

            </div>


            <h2 class="font-['Playfair_Display']
                           text-[24px]
                           font-semibold
                           text-[#1b1c1c]
                           mb-2">

                Your Kitchen is Empty

            </h2>


            <p class="font-['Inter']
                          text-[18px]
                          leading-[1.6]
                          text-[#55433f]
                          max-w-md
                          mb-6">

                Begin archiving your culinary journey.
                Your first masterpiece awaits.

            </p>


            <a asp-action="Create"
               class="bg-[#8b3e2f]
                          text-white
                          px-6 py-3
                          rounded
                          font-['Inter']
                          text-[14px]
                          font-semibold
                          tracking-[0.05em]
                          flex
                          items-center
                          gap-2
                          hover:bg-[#6d281a]
                          hover:-translate-y-[1px]
                          transition-all
                          no-underline">

                <span class="material-symbols-outlined text-[20px]">
                    add
                </span>

                Create Your First Recipe

            </a>

        </div>
    }

</section>



<!-- ========================================== -->
<!-- Shared Delete Modal -->
<!-- ========================================== -->

<div id="deleteModal"
     class="fixed inset-0 z-50
            flex items-center justify-center
            bg-[#1b1c1c]/60
            backdrop-blur-sm
            opacity-0
            pointer-events-none
            transition-opacity
            duration-300">


    <div id="deleteModalBox"
         class="bg-[#fcf9f8]
                border border-[#dac1bc]
                w-full max-w-md
                mx-4
                p-6
                shadow-[0_8px_24px_rgba(45,45,45,0.05)]
                scale-95
                transition-transform
                duration-300">


        <div class="flex items-start gap-4 mb-4">


            <div class="bg-[#ffdad6]
                        text-[#93000a]
                        p-2
                        shrink-0
                        flex
                        items-center
                        justify-center">

                <span class="material-symbols-outlined">
                    warning
                </span>

            </div>


            <div>

                <h2 class="font-['Playfair_Display']
                           text-[24px]
                           font-semibold
                           text-[#1b1c1c]
                           mb-1">

                    Delete Recipe?

                </h2>


                <p class="font-['Inter']
                          text-[16px]
                          leading-[1.6]
                          text-[#55433f]">

                    Are you sure you want to delete

                    <span id="deleteRecipeName"
                          class="font-semibold italic text-[#1b1c1c]">
                    </span>?

                    This action cannot be undone.

                </p>

            </div>

        </div>



        <!-- Buttons -->
        <div class="flex
                    justify-end
                    gap-3
                    mt-6
                    border-t
                    border-[#e5e1d8]
                    pt-4">


            <button type="button"
                    id="cancelDeleteBtn"
                    class="border border-[#6d281a]
                           text-[#6d281a]
                           px-5 py-2.5
                           font-['Inter']
                           text-[14px]
                           font-semibold
                           tracking-[0.05em]
                           rounded
                           hover:bg-[#f6f3f2]
                           transition-colors">

                Cancel

            </button>


            <form asp-action="Delete"
                  method="post"
                  id="deleteForm"
                  class="m-0">

                <button type="submit"
                        class="border border-[#ba1a1a]
                               bg-[#ba1a1a]
                               text-white
                               px-5 py-2.5
                               font-['Inter']
                               text-[14px]
                               font-semibold
                               tracking-[0.05em]
                               rounded
                               hover:bg-[#93000a]
                               hover:border-[#93000a]
                               transition-colors">

                    Delete Recipe

                </button>

            </form>

        </div>

    </div>

</div>



<!-- ========================================== -->
<!-- Delete Modal JavaScript -->
<!-- ========================================== -->

<script>

    const deleteModal = document.getElementById("deleteModal");
    const deleteModalBox = document.getElementById("deleteModalBox");
    const deleteForm = document.getElementById("deleteForm");
    const deleteRecipeName = document.getElementById("deleteRecipeName");
    const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");


    function openDeleteModal(id, name) {

        deleteRecipeName.textContent = name;

        deleteForm.action = `/Recipes/Delete/${id}`;


        deleteModal.classList.remove(
            "opacity-0",
            "pointer-events-none"
        );

        deleteModal.classList.add("opacity-100");


        deleteModalBox.classList.remove("scale-95");

        deleteModalBox.classList.add("scale-100");

    }


    function closeDeleteModal() {

        deleteModal.classList.remove("opacity-100");

        deleteModal.classList.add(
            "opacity-0",
            "pointer-events-none"
        );


        deleteModalBox.classList.remove("scale-100");

        deleteModalBox.classList.add("scale-95");

    }


    cancelDeleteBtn.addEventListener(
        "click",
        closeDeleteModal
    );


    deleteModal.addEventListener("click", (event) => {

        if (event.target === deleteModal) {

            closeDeleteModal();

        }

    });


    document.addEventListener("keydown", (event) => {

        if (event.key === "Escape") {

            closeDeleteModal();

        }

    });

</script>